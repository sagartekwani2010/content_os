{
 "schema": "content_os.visuals/spec@2",
 "reel": "food-tracker",
 "script": "TELEPROMPTER.md",
 "canvas": {
  "w": 1080,
  "h": 960,
  "fps": 30
 },
 "notes": "Lines come from TELEPROMPTER.md (beat N). Each beat = one template + params + word-anchored cues. Numbers only as @fact refs or {fact} placeholders (content_os/visuals/facts.py). Re-draft with: python -m content_os.visuals draft-spec outputs/food-tracker-reel",
